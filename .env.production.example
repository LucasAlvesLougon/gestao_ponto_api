# ==============================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - HOSTINGER (Laravel 12 API)
# Copie este arquivo para .env no servidor Hostinger e preencha as credenciais.
# ==============================================================================

APP_NAME="Gestão de Ponto"
APP_ENV=production
APP_KEY=base64:COLOQUE_A_CHAVE_GERADA_AQUI_OU_RODE_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.muponto.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ==============================================================================
# BANCO DE DADOS MYSQL (Criado no hPanel da Hostinger)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_gestaoponto
DB_USERNAME=u123456789_user
DB_PASSWORD=sua_senha_segura_do_banco

# ==============================================================================
# SESSÕES, CACHE E FILAS
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ==============================================================================
# SEGURANÇA, CORS E AUTENTICAÇÃO
# ==============================================================================
FRONTEND_URL=https://muponto.com
SANCTUM_STATEFUL_DOMAINS=muponto.com,app.muponto.com,ponto.muponto.com

# Google OAuth Client ID (Lembre de cadastrar a URL de produção no Google Cloud Console)
GOOGLE_CLIENT_ID=283172265638-2cib86k0v38qmjae78snu5ps1p4sd513.apps.googleusercontent.com
